# Skips npm lifecycle scripts (preinstall/install/postinstall) during
# `npm install`. This is required so that better-sqlite3 uses its bundled
# prebuilt native binary directly instead of attempting to compile from
# source via node-gyp — which otherwise fails on Windows with a "Could not
# find any Visual Studio installation" error unless the C++ Build Tools
# workload is installed.
#
# Safe: this does NOT affect `npm run dev`/`build`/etc. — those are run
# explicitly via `npm run`, not npm's install lifecycle. Verified that the
# two other packages with postinstall scripts (esbuild, unrs-resolver) also
# work correctly without them, since their platform-specific binaries are
# resolved automatically through npm's optionalDependencies mechanism, not
# through the postinstall script itself.
ignore-scripts=true
