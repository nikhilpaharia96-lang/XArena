# ============================================================================
# XArena — Environment Variables
# Copy this file to .env and fill in the values you have. The app runs
# fully for local development with ONLY the first three variables set
# (they already have safe local defaults below) — everything else is
# optional and only needed to enable that specific feature in production.
# ============================================================================

# --- Local database (SQLite) -------------------------------------------
# Not currently read by the local runtime (the SQLite file always lives at
# ./data/xarena.db, created automatically on first run) — kept here as the
# variable name Prisma/Postgres will use once you migrate to production.
# See README.md "Moving to Postgres in production" for that migration.
DATABASE_URL="file:./dev.db"

# --- Auth token secrets ---------------------------------------------------
# Used to sign JWT access/refresh tokens. The defaults below work fine for
# local development. For production, replace both with long random strings,
# e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-in-prod"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-prod"

# --- Razorpay (payments) --------------------------------------------------
# Required only for wallet deposits/withdrawals to work. Without these, the
# app runs normally but deposit attempts return a clear "payments not
# configured" message instead of failing silently.
# Get test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured under Razorpay Dashboard > Settings > Webhooks
# (different from the API key secret above)
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase (future auth/storage/push migration) ------------------------
# Not required to run the app today — current auth is email+password (JWT).
# Reserved for the planned migration to Firebase Authentication (email OTP,
# Google login), Firebase Storage (result screenshot uploads), and Firebase
# Cloud Messaging (push notifications). See README.md for details.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- SMTP / transactional email -------------------------------------------
# Required only for the admin "reset password" action to email the user
# directly. Without it, the temporary password is shown to the admin to
# relay manually — the feature still works, just without auto-email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
