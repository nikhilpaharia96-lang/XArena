# ============================================================================
# XArena — Environment Variables
# Copy this file to .env and fill in the values you have. The app runs
# fully for local development with ONLY the first three variables set
# (they already have safe local defaults below) — everything else is
# optional and only needed to enable that specific feature in production.
# ============================================================================

# --- Local database (SQLite) -------------------------------------------
# Not currently read by the local runtime (the SQLite file always lives at
# ./data/xarena.db, created automatically on first run) — kept here as the
# variable name Prisma/Postgres will use once you migrate to production.
# See README.md "Moving to Postgres in production" for that migration.
DATABASE_URL="file:./dev.db"

# --- Auth token secrets ---------------------------------------------------
# Used to sign JWT access/refresh tokens. The defaults below work fine for
# local development. For production, replace both with long random strings,
# e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-in-prod"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-prod"

# --- Razorpay (payments) --------------------------------------------------
# Required only for wallet deposits/withdrawals to work. Without these, the
# app runs normally but deposit attempts return a clear "payments not
# configured" message instead of failing silently.
# Get test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured under Razorpay Dashboard > Settings > Webhooks
# (different from the API key secret above)
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase (future auth/storage/push migration) ------------------------
# Not required to run the app today — current auth is email+password (JWT).
# Reserved for the planned migration to Firebase Authentication (email OTP,
# Google login), Firebase Storage (result screenshot uploads), and Firebase
# Cloud Messaging (push notifications). See README.md for details.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- SMTP / transactional email -------------------------------------------
# Enables self-service "Forgot password": players get an emailed link (valid
# 30 min, single use). Needs ALL of SMTP_* plus APP_PUBLIC_URL (below), which
# is used to build the link. Without them, a forgot-password request opens a
# support ticket instead and an admin resets the password (Admin > Users).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional sender address; defaults to SMTP_USER.
SMTP_FROM=

# Comma-separated signup codes required to create an account (leave empty to skip the check)
SIGNUP_CODES=

# --- AS Tech game provider (casino / live / crash / sportsbook) ------------
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_ and never commit real values.
# Credentials: AS Tech partner panel -> API Details. Sandbox and production
# keys are separate. Full setup guide: docs/astech-integration.md
ASTECH_API_BASE_URL=https://astechapi.cloud
ASTECH_API_KEY=
ASTECH_SECRET_KEY=
# Public HTTPS origin of this site. Used for the game exit_url, the Origin
# header AS Tech checks against your whitelisted domain, and the callback URL
# shown in Admin -> Game Provider. Must be https:// and match the domain
# whitelisted in the AS Tech panel. Example: https://xarena.in
APP_PUBLIC_URL=
# Optional: how often the cached game catalogue refreshes in the background
# (minutes, minimum 15, default 360). AS Tech recommends a few times per day.
ASTECH_CATALOGUE_TTL_MINUTES=360

# --- Web Push (phone/browser notifications) -------------------------------
# Generate ONCE with:  npx web-push generate-vapid-keys
# Keep the private key secret (host env var only, never commit it). Changing the keys later
# invalidates every player's existing subscription (they re-enable on next open).
# Leave blank to disable push — the app then simply doesn't offer notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach if your server misbehaves (mailto: or https: URL).
VAPID_SUBJECT=mailto:support@xarena.app

# --- Google login ("Continue with Google") ------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Type: Web application
#   Authorised redirect URI:  <APP_URL>/api/auth/google/callback
#     e.g. http://localhost:3000/api/auth/google/callback (local)
#          https://your-domain.com/api/auth/google/callback (production)
# Leave these empty to keep the button but show "not set up yet".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of the site (no trailing slash). Must match the redirect URI above.
APP_URL=
